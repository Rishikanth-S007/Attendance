# Used by docker-compose.yml. Copy to .env.
# openssl rand -hex 48
JWT_SECRET=
# Needed once to create the first admin; remove afterwards.
SETUP_TOKEN=
APP_TIMEZONE=Asia/Kolkata
# Address the browser and phones use to reach the backend:
PUBLIC_API_URL=http://localhost:5000/api
# Address the dashboard is served from (CORS):
DASHBOARD_ORIGIN=http://localhost:8080
