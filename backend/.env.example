# ---- Server ----
PORT=5000
NODE_ENV=development
# Set to 1 when running behind nginx / a load balancer so client IPs are correct.
TRUST_PROXY=0

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/attendance_system

# ---- Auth ----
# Use a long random value (e.g. `openssl rand -hex 48`). The server refuses to
# start in production with the placeholder below.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
# Needed once to create the very first admin via POST /api/auth/setup-first-admin
# (send it in the x-setup-token header). Remove it afterwards.
SETUP_TOKEN=

# ---- Kiosk / employee-app devices ----
# Check-in, check-out and leave requests require an X-Device-Key header issued
# from the dashboard (Devices page). Only turn this off for quick local tests.
REQUIRE_DEVICE_KEY=true

# ---- Face service ----
FACE_SERVICE_URL=http://127.0.0.1:8000
# Accept a match only if the Euclidean distance is at most this value
# (dlib model: ~0.6 is the library default, 0.5 is a stricter choice).
FACE_MAX_DISTANCE=0.50
# ...and the next-closest employee is at least this much farther away.
FACE_MIN_MARGIN=0.04

# ---- Time, shifts and rules ----
# IANA timezone used for "today", shift times and reports.
APP_TIMEZONE=Asia/Kolkata
# Block check-out within this many minutes of check-in (accidental double taps).
MIN_CHECKOUT_GAP_MINUTES=2

# ---- Geofencing ----
# When at least one active Office exists, check-in/out must be inside one.
GEOFENCE_ENFORCE=true
# GPS accuracy (metres) is forgiven up to this much when measuring distance.
GEOFENCE_MAX_ACCURACY_METERS=100

# ---- Leave ----
# Yearly allowance in days per leave type. "unpaid" is always unlimited.
LEAVE_ALLOWANCES={"casual":12,"sick":10,"earned":15}

# ---- Rate limits ----
# Face requests (check-in/out, verify, leave via app) per minute per client.
FACE_RATE_LIMIT_PER_MIN=20

# ---- Uploads ----
UPLOAD_MAX_SIZE_MB=5

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5173
